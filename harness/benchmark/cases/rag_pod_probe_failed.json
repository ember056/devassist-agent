{
  "id": "bench_rag_pod_probe_failed",
  "name": "Benchmark RAG Pod probe misconfiguration",
  "category": "rag",
  "capabilities": [
    "hybrid_retrieval",
    "source_citation",
    "faithfulness",
    "benchmark_labels",
    "citation_grounding"
  ],
  "endpoint": "/api/chat",
  "payload": {
    "Id": "bench-rag-pod-probe",
    "Question": "A pod keeps restarting because liveness probe fails during startup. How should I investigate probe misconfiguration? Please cite the knowledge base."
  },
  "labels": {
