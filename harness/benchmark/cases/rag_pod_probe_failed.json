      "pod_restart.md"
    ],
    "expectedEvidence": [
      "Probe misconfiguration",
      "liveness probe",
      "initial delay"
    ],
    "expectedSections": [
      "参考来源",
      "Faithfulness"
    ]
  },
  "assertions": {
    "contains": [
      "参考来源",
      "Faithfulness",
      "pod_restart.md"
    ],
    "not_contains": [
      "No relevant documents found"
    ],
    "json_path_exists": [
      "data.traceId",
      "data.answer"
    ],
    "json_path_equals": {
      "data.success": true
    },
    "max_duration_ms": 180000
  }
