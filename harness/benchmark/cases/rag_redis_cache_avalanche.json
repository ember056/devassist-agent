{
  "id": "bench_rag_redis_cache_avalanche",
  "name": "Benchmark RAG Redis cache avalanche",
  "category": "rag",
  "capabilities": [
    "hybrid_retrieval",
    "source_citation",
    "faithfulness",
    "benchmark_labels",
    "citation_grounding"
  ],
  "endpoint": "/api/chat",
  "payload": {
    "Id": "bench-rag-redis-avalanche",
    "Question": "Many cache keys expired together, cache hit rate dropped, and database QPS increased. What should I check for cache avalanche? Please cite the knowledge base."
  },
  "labels": {
    "expectedSources": [
      "redis_timeout.md"
    ],
    "expectedEvidence": [
      "Cache avalanche",
      "random TTL jitter",
      "Prewarm critical keys"
    ],
    "expectedSections": [
      "参考来源",
      "Faithfulness"
    ]
  },
  "assertions": {
    "contains": [
      "参考来源",
      "Faithfulness",
      "redis_timeout.md"
    ],
    "not_contains": [
      "No relevant documents found"
    ],
    "json_path_exists": [
      "data.traceId",
      "data.answer"
    ],
    "json_path_equals": {
      "data.success": true
    },
    "max_duration_ms": 180000
  }
}
